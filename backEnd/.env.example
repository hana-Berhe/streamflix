# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# Frontend URL allowed to call the API (comma-separate if more than one)
CLIENT_ORIGIN=http://localhost:5173

# Secret for signing login tokens. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# lax for local. Use none in production if frontend and backend are on different domains.
COOKIE_SAMESITE=lax

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=streamflex
# Aiven: the path to the CA file (ca.pem) or the certificate text in double quotes.
# Leave empty for a local database.
DB_SSL_CA=

# Gemini AI suggestions (optional). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
